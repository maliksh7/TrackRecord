# Copy to .env (never commit .env). Docker Compose reads it automatically.

# DB API Marketplace (developers.deutschebahn.com): create an app, subscribe it to "Timetables" (free plan).
DB_CLIENT_ID=
DB_API_KEY=
# Free plan = 60 req/min; keep headroom for manual calls.
DB_REQUESTS_PER_MINUTE=50

POSTGRES_DB=trackrecord
POSTGRES_USER=trackrecord
POSTGRES_PASSWORD=change-me
READONLY_PASSWORD=change-me-too

GRAFANA_ADMIN_PASSWORD=change-me-as-well
